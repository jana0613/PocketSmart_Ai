APP_NAME=PocketSmart AI
SECRET_KEY=change-this-in-development
GEMINI_API_KEY=
# Documentation originally names Gemini 1.5 Flash Pro. That model is no longer the current API target.
# Use a currently available model; change this only if your API project has access to another model.
GEMINI_MODEL=gemini-3.8-flash
DATABASE_PATH=data/pocketsmart.db
ACCESS_TOKEN_MINUTES=120
MAX_UPLOAD_MB=5
